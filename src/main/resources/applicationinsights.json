{
  "connectionString": "InstrumentationKey=2149a452-3872-4a02-843b-7664790695e0;IngestionEndpoint=https://westeurope-5.in.applicationinsights.azure.com/;LiveEndpoint=https://westeurope.livediagnostics.monitor.azure.com/;ApplicationId=454aeb75-b210-476f-b946-64656a4b4eb1",
  "role": {
    "name": "PoliclinaBine-API",
    "instance": "${WEBSITE_INSTANCE_ID:local}"
  },
  "sampling": {
    "percentage": 100
  },
  "instrumentation": {
    "logging": {
      "level": "INFO"
    },
    "micrometer": {
      "enabled": true
    }
  },
  "heartbeat": {
    "intervalSeconds": 60
  },
  "preview": {
    "instrumentation": {
      "springIntegration": {
        "enabled": true
      }
    },
    "liveMetrics": {
      "enabled": true
    },
    "sampling": {
      "overrides": [
        {
          "telemetryType": "dependency",
          "attributes": [
            {
              "key": "db.system",
              "value": "postgresql",
              "matchType": "strict"
            }
          ],
          "percentage": 100
        },
        {
          "telemetryType": "trace",
          "attributes": [
            {
              "key": "level",
              "value": "ERROR",
              "matchType": "strict"
            }
          ],
          "percentage": 100
        }
      ]
    }
  },
  "customDimensions": {
    "service.name": "PoliclinaBine",
    "service.version": "0.0.1-SNAPSHOT",
    "environment": "dev",
    "instance": "local-dev-instance"
  }
}
