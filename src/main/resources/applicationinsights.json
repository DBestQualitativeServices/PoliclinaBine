{
  "role": {
    "name": "PoliclinaBine-API",
    "instance": "${WEBSITE_INSTANCE_ID:local}"
  },
  "sampling": {
    "percentage": 100
  },
  "instrumentation": {
    "logging": {
      "level": "INFO"
    },
    "micrometer": {
      "enabled": true
    }
  },
  "heartbeat": {
    "intervalSeconds": 60
  },
  "preview": {
    "instrumentation": {
      "springIntegration": {
        "enabled": true
      }
    },
    "liveMetrics": {
      "enabled": true
    },
    "sampling": {
      "overrides": [
        {
          "telemetryType": "dependency",
          "attributes": [
            {
              "key": "db.system",
              "value": "postgresql",
              "matchType": "strict"
            }
          ],
          "percentage": 100
        },
        {
          "telemetryType": "trace",
          "attributes": [
            {
              "key": "level",
              "value": "ERROR",
              "matchType": "strict"
            }
          ],
          "percentage": 100
        }
      ]
    }
  },
  "customDimensions": {
    "service.name": "PoliclinaBine",
    "service.version": "0.0.1-SNAPSHOT",
    "environment": "${SPRING_PROFILES_ACTIVE:dev}"
  }
}
