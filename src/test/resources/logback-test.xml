<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <!-- Console appender for test output -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <!-- Root logger - WARN level to reduce noise -->
    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>

    <!-- Application package - DEBUG for detailed test info -->
    <logger name="com.example.policlicabine" level="DEBUG"/>

    <!-- Spring Framework - INFO level -->
    <logger name="org.springframework" level="INFO"/>
    <logger name="org.springframework.test" level="INFO"/>
    <logger name="org.springframework.boot" level="INFO"/>

    <!-- Spring Security - DEBUG for security tests -->
    <logger name="org.springframework.security" level="DEBUG"/>

    <!-- Hibernate SQL - DEBUG to see queries -->
    <logger name="org.hibernate.SQL" level="DEBUG"/>
    <logger name="org.hibernate.type.descriptor.sql.BasicBinder" level="TRACE"/>

    <!-- Reduce Hibernate noise -->
    <logger name="org.hibernate.engine.internal" level="WARN"/>
    <logger name="org.hibernate.engine.transaction.internal" level="WARN"/>

    <!-- Test containers -->
    <logger name="org.testcontainers" level="INFO"/>
    <logger name="com.github.dockerjava" level="WARN"/>

    <!-- Reduce H2 noise -->
    <logger name="org.h2" level="WARN"/>

    <!-- Mockito -->
    <logger name="org.mockito" level="WARN"/>
</configuration>
