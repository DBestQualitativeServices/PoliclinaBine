# Auto-detect text files and normalize to LF on commit
* text=auto eol=lf

# Source code files - always LF
*.java text eol=lf
*.kt text eol=lf
*.xml text eol=lf
*.properties text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.txt text eol=lf

# Shell scripts - always LF
*.sh text eol=lf
/mvnw text eol=lf

# Windows scripts - always CRLF
*.cmd text eol=crlf
*.bat text eol=crlf

# Binary files - no conversion
*.jar binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
